# Live settings for the VPS: copy to .env next to compose.yaml and fill in.
# Never commit .env. Locally you don't need a .env at all.

# Public addresses. Caddy gets HTTPS certificates for these automatically:
# point their DNS at the VPS and open ports 80 and 443.
KESTON_ID_ISSUER=https://id.keston.co
KESTON_ID_SITE=id.keston.co
KESTON_WORK_SITE=work.keston.co
KESTON_ADMIN_SITE=admin.keston.co
ACME_EMAIL=admin@keston.co

# Register the live apps (deploy/clients.json).
KESTON_ID_CLIENTS_FILE=clients.json

# 32 random bytes, base64: openssl rand -base64 32
# Encrypts signing keys and two-step secrets in the database. Back it up:
# losing it means everyone has to set up two-step verification again.
KESTON_ID_SECRET_KEY=

# openssl rand -base64 24
POSTGRES_PASSWORD=

# Each app's client secret (openssl rand -base64 32). Give the same value to
# the app itself.
KESTON_LEARN_CLIENT_SECRET=
KESTON_FORMS_CLIENT_SECRET=
KESTON_WORK_CLIENT_SECRET=
