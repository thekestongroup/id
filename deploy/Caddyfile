# Caddy: the front door for Keston apps. It routes by hostname and spreads
# requests across every keston-id replica (docker compose --scale).
#
#   local: http://id.keston.localhost, http://work.keston.localhost
#   live:  https://id.keston.co, https://work.keston.co (certificates are
#          automatic: point DNS at the VPS and open ports 80 and 443)
#
# The site addresses come from .env (see compose.yaml for the defaults).

{
	email {$ACME_EMAIL:admin@keston.co}
}

{$KESTON_ID_SITE} {
	encode zstd gzip
	reverse_proxy {
		# Every replica, found by Docker's DNS; new ones are picked up.
		dynamic a {
			name keston-id
			port 8080
			refresh 5s
		}
		lb_policy round_robin
		# Try another replica if one is restarting.
		lb_try_duration 5s
		fail_duration 10s
	}
}

# Keston Admin: the web app (the "admin" container, from the admin repo),
# with Keston ID's API (/v1) on the same origin at /api.
{$KESTON_ADMIN_SITE} {
	encode zstd gzip
	handle_path /api/* {
		rewrite * /v1{uri}
		reverse_proxy {
			dynamic a {
				name keston-id
				port 8080
				refresh 5s
			}
			lb_policy round_robin
			lb_try_duration 5s
			fail_duration 10s
		}
	}
	handle {
		reverse_proxy admin:8080
	}
}

# Keston Work. Until the app exists, a stand-in page where sign-ins land,
# showing what Keston ID sent back. When it does, replace the respond block
# with: reverse_proxy work:3000
{$KESTON_WORK_SITE} {
	header Content-Type "text/html; charset=utf-8"
	respond <<HTML
		<!doctype html>
		<html lang="en-GB">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>Keston Work</title>
		<body style="font-family: system-ui, sans-serif; max-width: 40rem; margin: 3rem auto; padding: 0 1rem; line-height: 1.5">
		<h1>Keston Work</h1>
		<p>The Keston Work app isn't running yet. This page stands in for it, so you can test signing in with Keston ID.</p>
		<p>Keston ID sent you back to: <code style="word-break: break-all">{http.request.uri}</code></p>
		<p><a href="{$KESTON_ID_ISSUER}/account">Your Keston account</a></p>
		</body>
		</html>
		HTML 200
}
