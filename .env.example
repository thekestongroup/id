# Copy to .env and fill in. Never commit .env.

# The public address. Must be the same on every replica.
KESTON_ID_ISSUER=http://localhost:4444

# 32 random bytes, base64: openssl rand -base64 32
# Encrypts signing keys and two-step secrets in the database. Losing it
# means everyone has to set up two-step verification again.
KESTON_ID_SECRET_KEY=

POSTGRES_PASSWORD=keston

# Client secrets for the apps in deploy/clients.json (openssl rand -base64 32).
KESTON_LEARN_CLIENT_SECRET=
KESTON_SCHOOLS_CLIENT_SECRET=
KESTON_WORK_CLIENT_SECRET=

# Optional lifetimes (Go durations).
# KESTON_ID_ACCESS_TOKEN_TTL=15m
# KESTON_ID_ID_TOKEN_TTL=1h
# KESTON_ID_REFRESH_TOKEN_TTL=720h
# KESTON_ID_SESSION_TTL=336h
